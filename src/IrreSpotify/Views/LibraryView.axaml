<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IrreSpotify.ViewModels"
             xmlns:models="using:IrreSpotify.Models"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="IrreSpotify.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="RootLibraryView">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20" Background="#09090B">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Your Library" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#A7A7A7"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Command="{Binding LoadLibraryCommand}" 
                        Content="🔄 Refresh" 
                        Background="#18181C" 
                        Foreground="White" 
                        CornerRadius="16" 
                        Padding="14,8" 
                        FontSize="12"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Loading Progress Bar -->
        <ProgressBar Grid.Row="1" 
                     IsIndeterminate="True" 
                     IsVisible="{Binding IsLoading}" 
                     Height="3" 
                     VerticalAlignment="Top" 
                     Foreground="{DynamicResource PrimaryBrush}" 
                     Background="Transparent"/>

        <!-- Playlists Grid List -->
        <ScrollViewer Grid.Row="1" Padding="24,20">
            <ListBox ItemsSource="{Binding Playlists}" 
                     SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" 
                     Background="Transparent" 
                     BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,16,16"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistItem">
                        <Border Width="180" Height="240" CornerRadius="12" Background="#18181C" Padding="14">
                            <Grid RowDefinitions="150, *, Auto">
                                <!-- Cover Container -->
                                <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Background="#24242A" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock Text="🎵" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding CoverUrl}" 
                                               IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                                               Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Title -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Name}" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           Margin="0,8,0,0" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Bottom Row: Owner & Play Button -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Owner}" 
                                               FontSize="12" 
                                               Foreground="#A7A7A7" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Column="1" 
                                            Command="{Binding PlayCommand}" 
                                            Background="{DynamicResource PrimaryBrush}" 
                                            Foreground="Black" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32" 
                                            Padding="0" 
                                            Cursor="Hand">
                                        <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
