<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IrreSpotify.ViewModels"
             xmlns:models="using:IrreSpotify.Models"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="IrreSpotify.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Search Header Bar -->
        <Border Grid.Row="0" Padding="24,20" Background="#09090B">
            <StackPanel Spacing="12">
                <TextBlock Text="Search Tracks" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <Grid ColumnDefinitions="*, Auto" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchQuery, Mode=TwoWay}" 
                             Watermark="Search tracks, artists, or albums..." 
                             Height="42" 
                             CornerRadius="20" 
                             Padding="16,10" 
                             FontSize="14" 
                             Background="#18181C" 
                             BorderBrush="#2A2A30" 
                             Foreground="White"/>
                    <Button Grid.Column="1" 
                            Command="{Binding PerformSearchCommand}" 
                            Margin="8,0,0,0" 
                            Content="🔍 Search" 
                            Background="#1DB954" 
                            Foreground="Black" 
                            FontWeight="SemiBold" 
                            Height="42" 
                            CornerRadius="20" 
                            Padding="20,0" 
                            Cursor="Hand"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#A7A7A7"/>
            </StackPanel>
        </Border>

        <!-- Search Results List -->
        <ScrollViewer Grid.Row="1" Padding="24,10">
            <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackItem">
                        <Border Margin="0,4" Padding="12" CornerRadius="8" Background="#18181C">
                            <Grid ColumnDefinitions="48, *, Auto, Auto">
                                <!-- Album Cover -->
                                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Width="40" Height="40" Background="#24242A">
                                    <Grid>
                                        <TextBlock Text="🎵" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#A7A7A7"/>
                                </StackPanel>

                                <!-- Album Name -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding Album}" 
                                           VerticalAlignment="Center" 
                                           Foreground="#888888" 
                                           FontSize="13" 
                                           Margin="20,0" 
                                           MaxWidth="200" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Duration & Play Button -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DurationText}" Foreground="#A7A7A7" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).PlayTrackCommand}" 
                                            CommandParameter="{Binding}" 
                                            Background="#1DB954" 
                                            Foreground="Black" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32" 
                                            Padding="0" 
                                            Cursor="Hand">
                                        <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
