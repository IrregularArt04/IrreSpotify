<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IrreSpotify.ViewModels"
        xmlns:views="using:IrreSpotify.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
        x:Class="IrreSpotify.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="IrreSpotify Lite"
        Icon="/img/icon.ico"
        Width="1100" Height="720"
        MinWidth="950" MinHeight="600"
        Background="#09090B"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:SearchViewModel">
            <views:SearchView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:LibraryViewModel">
            <views:LibraryView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:PlaylistDetailViewModel">
            <views:PlaylistDetailView DataContext="{Binding}"/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="*, Auto">
        <!-- Main Layout (Sidebar + Content) -->
        <Grid Grid.Row="0" ColumnDefinitions="240, *">
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0" Background="#000000" Padding="16,20" BorderBrush="#1C1C20" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- App Brand Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,0,24">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Border CornerRadius="16" Width="32" Height="32" Background="{DynamicResource PrimaryBrush}">
                                <TextBlock Text="⚡" FontSize="18" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IrreSpotify" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                <TextBlock Text="Spotify Lite" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Color Picker Button -->
                        <Button Grid.Column="1"
                                ToolTip.Tip="Cambiar Color Principal"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimaryBrush}" BorderBrush="White" BorderThickness="1.5">
                                <TextBlock Text="🎨" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Border Background="#18181C" CornerRadius="12" Padding="14" Width="260" BorderBrush="#282830" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Color Principal" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock Text="Selecciona un color de acento:" FontSize="11" Foreground="#A7A7A7"/>

                                            <!-- Preset Color Swatches -->
                                            <WrapPanel ItemWidth="34" ItemHeight="34">
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#1DB954" Width="28" Height="28" CornerRadius="14" Background="#1DB954" Margin="3" Cursor="Hand" ToolTip.Tip="Spotify Green"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#00D1B2" Width="28" Height="28" CornerRadius="14" Background="#00D1B2" Margin="3" Cursor="Hand" ToolTip.Tip="Emerald Mint"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#1D9BF0" Width="28" Height="28" CornerRadius="14" Background="#1D9BF0" Margin="3" Cursor="Hand" ToolTip.Tip="Cyan Blue"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#8A2BE2" Width="28" Height="28" CornerRadius="14" Background="#8A2BE2" Margin="3" Cursor="Hand" ToolTip.Tip="Electric Purple"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#FF2D55" Width="28" Height="28" CornerRadius="14" Background="#FF2D55" Margin="3" Cursor="Hand" ToolTip.Tip="Neon Pink"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#FF9500" Width="28" Height="28" CornerRadius="14" Background="#FF9500" Margin="3" Cursor="Hand" ToolTip.Tip="Flame Orange"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#FFCC00" Width="28" Height="28" CornerRadius="14" Background="#FFCC00" Margin="3" Cursor="Hand" ToolTip.Tip="Gold Yellow"/>
                                                <Button Command="{Binding ChangeThemeColorCommand}" CommandParameter="#E50914" Width="28" Height="28" CornerRadius="14" Background="#E50914" Margin="3" Cursor="Hand" ToolTip.Tip="Crimson Red"/>
                                            </WrapPanel>

                                            <!-- Custom Hex Input -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <TextBlock Text="Hex:" VerticalAlignment="Center" Foreground="#A7A7A7" FontSize="11"/>
                                                <TextBox Text="{Binding CustomHexColor, Mode=TwoWay}" Width="100" Padding="6,4" Background="#121215" Foreground="White" CornerRadius="6" FontSize="12"/>
                                                <Button Content="Aplicar" Command="{Binding ApplyCustomHexColorCommand}" Background="{DynamicResource PrimaryBrush}" Foreground="Black" FontWeight="Bold" Padding="10,4" CornerRadius="6" FontSize="11" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" Spacing="6">
                        <Button Command="{Binding NavigateToSearchCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,10" 
                                CornerRadius="8" 
                                Background="#18181C" 
                                Foreground="White" 
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="🔍" FontSize="16"/>
                                <TextBlock Text="Search" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToLibraryCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,10" 
                                CornerRadius="8" 
                                Background="Transparent" 
                                Foreground="#A7A7A7" 
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="📚" FontSize="16"/>
                                <TextBlock Text="Library" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Account / Session Box -->
                    <Border Grid.Row="3" CornerRadius="10" Padding="12" Background="#121215" BorderBrush="#222226" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border CornerRadius="14" Width="28" Height="28" Background="{DynamicResource PrimaryBrush}">
                                    <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding UserName}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           Foreground="White" 
                                           VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis" 
                                           Width="130"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AuthMessage}" 
                                       FontSize="10" 
                                       Foreground="#FFC107" 
                                       TextWrapping="Wrap" 
                                       IsVisible="{Binding AuthMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Login / Logout Actions -->
                            <Button Command="{Binding LoginCommand}" 
                                    IsVisible="{Binding !IsAuthenticated}" 
                                    HorizontalAlignment="Stretch" 
                                    Background="{DynamicResource PrimaryBrush}" 
                                    Foreground="Black" 
                                    FontWeight="Bold" 
                                    CornerRadius="16" 
                                    Padding="0,8" 
                                    Cursor="Hand">
                                <TextBlock Text="Connect Spotify" HorizontalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding LogoutCommand}" 
                                    IsVisible="{Binding IsAuthenticated}" 
                                    HorizontalAlignment="Stretch" 
                                    Background="#26262B" 
                                    Foreground="#A7A7A7" 
                                    CornerRadius="16" 
                                    Padding="0,6" 
                                    Cursor="Hand">
                                <TextBlock Text="Disconnect" HorizontalAlignment="Center" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Bottom Player Bar -->
        <views:PlayerBarView Grid.Row="1" DataContext="{Binding PlayerViewModel}"/>
    </Grid>
</Window>
